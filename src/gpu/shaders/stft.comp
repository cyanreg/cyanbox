// Band energies of a short-time Fourier transform (cyanbox/compute.h,
// CBComputeSTFT): one workgroup per frame. The frame's 2M samples are
// windowed into shared memory as M complex points, transformed, split into
// the real spectrum's power |X_k|^2 (k in [0, M]), and each band sums the
// power under its weights, compressed as log(1 + scale * sqrt(sum)).
//
// The band sums keep four accumulators and add them as (a0 + a1) + (a2 +
// a3), as spectrum.c's CPU loop does, so that the order of the additions is
// not one more difference between the two paths.
//
// The power spectrum is kept in the transform's own shared array, two bins
// to a complex point, once the split has read it: an array of its own
// (M + 1 floats) took an 8192-point transform to 49156 bytes of shared
// memory, over the 49152 the Iris Xe has.

#version 460
#extension GL_GOOGLE_include_directive : require

layout(local_size_x = 256) in;

#include "fft.glsl"

layout(buffer_reference, std430, buffer_reference_align = 4) readonly buffer Floats {
    float v[];
};

layout(buffer_reference, std430, buffer_reference_align = 4) readonly buffer Ints {
    int v[];
};

layout(buffer_reference, std430, buffer_reference_align = 4) writeonly buffer Out {
    float v[];
};

layout(push_constant, std430) uniform Push {
    Twiddles tw;
    Floats   window;        // 2M
    Ints     bands;         // [nb_bands][3]: first bin, end bin, first weight
    Floats   weights;
    Floats   samples;       // frame f starts at samples[f * hop]
    Out      dst;           // [nb_frames][nb_bands]
    uint     hop;
    uint     nb_bands;
    uint     nb_frames;
    float    scale;
} pc;

// The power of bin k in [0, M], in buf (see above).
float pw(uint k)
{
    return buf[k >> 1u][k & 1u];
}

// The bins an invocation splits, M / 2 + 1 over THREADS, for M <= 4096.
#define NB_SPLIT 9u

void main()
{
    uint tid = gl_LocalInvocationIndex;
    uint f = gl_WorkGroupID.x;
    if (f >= pc.nb_frames)
        return;
    uint base = f * pc.hop;

    for (uint m = tid; m < M; m += THREADS) {
        buf[m] = vec2(pc.samples.v[base + 2u * m] * pc.window.v[2u * m],
                      pc.samples.v[base + 2u * m + 1u] * pc.window.v[2u * m + 1u]);
    }
    memoryBarrierShared();
    barrier();

    fft_forward(pc.tw);

    // Every split reads two points anywhere in buf: all are read before
    // any power is written over them. (k = M / 2 writes its one bin twice,
    // the second value last, as before.)
    float pk[NB_SPLIT], pmk[NB_SPLIT];
    for (uint i = 0u; i < NB_SPLIT; i++) {
        uint k = tid + i * THREADS;
        if (k <= M / 2u) {
            vec2 xk, xmk;
            real_split(pc.tw, k, xk, xmk);
            pk[i] = xk.x * xk.x + xk.y * xk.y;
            pmk[i] = xmk.x * xmk.x + xmk.y * xmk.y;
        }
    }
    memoryBarrierShared();
    barrier();
    for (uint i = 0u; i < NB_SPLIT; i++) {
        uint k = tid + i * THREADS;
        if (k <= M / 2u) {
            buf[k >> 1u][k & 1u] = pk[i];
            buf[(M - k) >> 1u][(M - k) & 1u] = pmk[i];
        }
    }
    memoryBarrierShared();
    barrier();

    for (uint b = tid; b < pc.nb_bands; b += THREADS) {
        int k0 = pc.bands.v[3u * b], k1 = pc.bands.v[3u * b + 1u];
        int w = pc.bands.v[3u * b + 2u] - k0;
        float a0 = 0.0, a1 = 0.0, a2 = 0.0, a3 = 0.0;
        int k = k0;
        for (; k + 4 <= k1; k += 4) {
            a0 += pc.weights.v[w + k] * pw(uint(k));
            a1 += pc.weights.v[w + k + 1] * pw(uint(k + 1));
            a2 += pc.weights.v[w + k + 2] * pw(uint(k + 2));
            a3 += pc.weights.v[w + k + 3] * pw(uint(k + 3));
        }
        for (; k < k1; k++)
            a0 += pc.weights.v[w + k] * pw(uint(k));
        float s = (a0 + a1) + (a2 + a3);
        pc.dst.v[f * pc.nb_bands + b] = pc.scale > 0.0 ? log(1.0 + pc.scale * sqrt(s)) : s;
    }
}

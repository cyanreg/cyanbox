// Band envelopes of windows (rxbox/compute.h, RXComputeEnv): one workgroup
// per window and band. The window's 2M samples are tapered into shared
// memory, transformed, multiplied by the band's real gains (zero phase:
// the band's signal is not delayed), transformed back, and the root mean
// square of the band's signal over 2h + 1 samples is taken at the output
// points. Each band transforms its window again rather than keep the
// spectrum: a second 4096-point array would need all 64 kB of shared
// memory, and the transform costs less than the energies after it.
//
// The energies are compensated (Kahan) sums: the CPU sums in double, and a
// plain float sum of 441 squares would be ten times further from it than
// the transforms are.

#version 460
#extension GL_GOOGLE_include_directive : require

layout(local_size_x = 256) in;

#include "fft.glsl"

layout(buffer_reference, std430, buffer_reference_align = 4) readonly buffer Floats {
    float v[];
};

layout(buffer_reference, std430, buffer_reference_align = 4) readonly buffer Ints {
    int v[];
};

layout(buffer_reference, std430, buffer_reference_align = 4) writeonly buffer Out {
    float v[];
};

layout(push_constant, std430) uniform Push {
    Twiddles tw;
    Floats   taper;         // 2M
    Floats   gains;         // [nb_bands][M + 1]
    Ints     widths;        // [nb_bands]: h
    Floats   windows;       // [nb_windows][2M]
    Out      dst;           // [nb_windows][nb_bands][2 * half + 1]
    uint     step;
    uint     half_len;
    uint     nb_bands;
    uint     nb_windows;
} pc;

void main()
{
    uint tid = gl_LocalInvocationIndex;
    uint win = gl_WorkGroupID.x, band = gl_WorkGroupID.y;
    if (win >= pc.nb_windows || band >= pc.nb_bands)
        return;
    uint base = win * 2u * M;

    for (uint m = tid; m < M; m += THREADS) {
        buf[m] = vec2(pc.windows.v[base + 2u * m] * pc.taper.v[2u * m],
                      pc.windows.v[base + 2u * m + 1u] * pc.taper.v[2u * m + 1u]);
    }
    memoryBarrierShared();
    barrier();

    fft_forward(pc.tw);

    // Each invocation owns the pairs (k, M - k) it reads and writes, so no
    // barrier is needed between the split, the gains and the merge.
    uint g = band * (M + 1u);
    for (uint k = tid; k <= M / 2u; k += THREADS) {
        vec2 xk, xmk;
        real_split(pc.tw, k, xk, xmk);
        xk *= pc.gains.v[g + k];
        xmk *= pc.gains.v[g + M - k];
        vec2 zk, zmk;
        real_merge(pc.tw, k, xk, xmk, zk, zmk);
        buf[k] = zk;
        if (k > 0u && k < M / 2u)
            buf[M - k] = zmk;
    }
    memoryBarrierShared();
    barrier();

    fft_forward(pc.tw);

    // buf[m] is now conj(y[2m] + i y[2m + 1]); only squares are read.
    uint len = 2u * pc.half_len + 1u;
    int h = pc.widths.v[band];
    uint out_base = (win * pc.nb_bands + band) * len;
    for (uint i = tid; i < len; i += THREADS) {
        int p = int(M) + (int(i) - int(pc.half_len)) * int(pc.step);
        precise float s = 0.0, c = 0.0;
        for (int j = p - h; j <= p + h; j++) {
            vec2 z = buf[uint(j) >> 1u];
            float y = (j & 1) != 0 ? z.y : z.x;
            precise float t = y * y - c;
            precise float u = s + t;
            c = (u - s) - t;
            s = u;
        }
        pc.dst.v[out_base + i] = sqrt(max(s / float(2 * h + 1), 0.0));
    }
}
